{
  "name": "xian_game",
  "version": "1.0.0",
  "description": "修仙传说2D - 2D动作修仙游戏",
  "private": true,
  "scripts": {
    "lint": "eslint js/",
    "lint:fix": "eslint js/ --fix",
    "format": "prettier --write \"js/**/*.js\" \"*.html\" \"css/**/*.css\"",
    "format:check": "prettier --check \"js/**/*.js\" \"*.html\" \"css/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "smoke": "node scripts/smoke.mjs",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "eslint": "^8.45.0",
    "globals": "^13.20.0",
    "husky": "^8.0.0",
    "jest": "^29.6.0",
    "jest-environment-jsdom": "^29.6.0",
    "prettier": "^3.0.0",
    "typescript": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}